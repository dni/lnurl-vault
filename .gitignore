.pio/
.vscode/
sdkconfig
sdkconfig.old
# PlatformIO generates a per-environment sdkconfig.<env> (confirmed via an
# actual build: sdkconfig.t-display-s3) — ignore that pattern, but not our
# own hand-authored sdkconfig.defaults.
sdkconfig.*
!sdkconfig.defaults
build/
test/native/vault_tests
*.o

# PlatformIO auto-generates a project-root CMakeLists.txt wrapping ESP-IDF's
# project.cmake — confirmed via an actual build, not guessed. This is
# distinct from (and must not shadow) src/CMakeLists.txt, which IS tracked
# and hand-maintained — the leading slash anchors this to the root only.
/CMakeLists.txt

# ESP-IDF Component Manager output (src/idf_component.yml's esp_tinyusb
# dependency) — regenerated by every build, not meant to be committed.
managed_components/
dependencies.lock

# Vendored third-party QR encoder (ricmoo/QRCode) — deliberately not
# committed, see README.md's "Build & flash" and src/ui/qr_display.c's
# header comment for why and how to fetch it yourself.
src/ui/qrcode.h
src/ui/qrcode.c
